[Unit]
Description=Control My Server Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/etc/control-my-server-bot
ExecStart=/usr/bin/control-my-server-bot
Restart=always
RestartSec=5
# Load environment variables from /etc/control-my-server-bot/.env
# godotenv will automatically load it from the WorkingDirectory

[Install]
WantedBy=multi-user.target
