[Unit]
Description=Control My Server Telegram Bot
After=network.target

[Service]
Type=simple
User=control_my_server_bot_user
Group=control_my_server_bot_user
WorkingDirectory=/opt/control_my_server_bot
ExecStartPre=/opt/control_my_server_bot/apply_update.sh
ExecStart=/opt/control_my_server_bot/control_my_server_bot
Restart=always
RestartSec=5
# Capability to restart services and reboot is handled via Polkit/Sudoers
# permissions for the control_my_server_bot_user user, rather than running the service as root.

# Elevated scheduling and priority to remain responsive under heavy load
Nice=-10
CPUSchedulingPolicy=rr
CPUSchedulingPriority=1
IOSchedulingClass=realtime
IOSchedulingPriority=4
OOMScoreAdjust=-1000

# Load environment variables from /opt/control_my_server_bot/.env
# godotenv will automatically load it from the WorkingDirectory

[Install]
WantedBy=multi-user.target
